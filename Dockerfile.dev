# Shopkeepers Legacy local development image.
# Compose mounts the working tree over /app and keeps dependencies in a named volume.
FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY index.html tsconfig.json vite.config.ts ./
COPY src ./src
COPY public ./public
COPY scripts/npc-chat-server.mjs scripts/npc-chat-supervisor.mjs ./scripts/

EXPOSE 5273 5277
