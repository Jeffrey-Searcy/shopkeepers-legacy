{
  "name": "shopkeepers-legacy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stardew Valley x Moonlighter browser game — Phaser 3 + TypeScript + Vite",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
