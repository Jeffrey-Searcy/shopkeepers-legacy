{
  "name": "shopkeepers-legacy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stardew Valley x Moonlighter browser game — Phaser 3 + TypeScript + Vite",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "npc-chat": "node scripts/npc-chat-server.mjs",
    "npc-chat:local": "SHOPKEEPERS_LOCAL_MODEL=gemma4:12b SHOPKEEPERS_OLLAMA_URL=http://127.0.0.1:11434 node scripts/npc-chat-server.mjs",
    "docker:up": "docker compose up --detach --build",
    "docker:down": "docker compose down",
    "docker:status": "docker compose ps",
    "docker:logs": "docker compose logs --follow game chat",
    "test": "playwright test",
    "test:headed": "playwright test --headed"
  },
  "dependencies": {
    "phaser": "^3.80.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^26.1.0",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
